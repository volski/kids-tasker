rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile metadata - strictly requires authenticated user
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Family workspaces & chores - accessible for authenticated users and tokenized tablets
    match /families/{familyId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
