rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is user a registered parent of this family?
    function isFamilyParent(familyId) {
      return isAuthenticated() && (
        request.auth.token.role == 'parent' && request.auth.token.familyId == familyId ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.parents)
      );
    }

    // Helper: is user an authorized member (parent or paired tablet/kid) of this family?
    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        request.auth.token.familyId == familyId ||
        isFamilyParent(familyId) ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members)
      );
    }

    // Family document
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAuthenticated();
      allow update, delete: if isFamilyParent(familyId);

      // Children collection
      match /children/{childId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyParent(familyId);
        allow update: if isFamilyParent(familyId);

        // Tasks subcollection
        match /tasks/{taskId} {
          allow read: if isFamilyMember(familyId);
          allow create, delete: if isFamilyParent(familyId);
          
          // Parents can do any updates (mark done, mark undone, edit title/icon)
          // Children / Tablets can ONLY toggle completed: false -> true (One-Way Rule!)
          allow update: if isFamilyParent(familyId) || (
            isFamilyMember(familyId) &&
            resource.data.completed == false &&
            request.resource.data.completed == true
          );
        }
      }

      // Daily History collection
      match /history/{date} {
        allow read: if isFamilyMember(familyId);
        allow write: if isFamilyMember(familyId);
      }

      // Settings and Smart Home configuration
      match /settings/{settingId} {
        allow read, write: if isFamilyParent(familyId);
      }
    }
  }
}
