rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile metadata - must be authenticated
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Family workspaces & data - must be authenticated
    match /families/{familyId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
